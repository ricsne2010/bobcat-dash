# Bobcat dash: lets the dash power the Pi off at key-off, without a password.
# Install:  sudo install -m 440 tools/bobcat-dash-sudoers /etc/sudoers.d/bobcat-dash
#           sudo visudo -c        (checks the syntax; it must say "parsed OK")
# Change "pi" if you picked a different username.
pi ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff
