# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# KiCad: automatic backups, per-user view settings, lock and cache files
breakout-board/kicad/*-backups/
*.kicad_prl
*.lck
fp-info-cache

# board generator scratch output (build.sh writes here; the results are copied to kicad/ and fab/)
breakout-board/generator/out/
breakout-board/generator/drc.json
breakout-board/generator/route.dsn
breakout-board/generator/route.ses
breakout-board/generator/*.kicad_sch
breakout-board/ads1115-adapter/generator/out/
breakout-board/ads1115-adapter/generator/route.dsn
breakout-board/ads1115-adapter/generator/route.ses
breakout-board/ads1115-adapter/kicad/*-backups/

# diagram scripts: temporary PNGs (the published diagrams are the .jpg files in docs/)
tools/diagrams/*.png

# manufacturer 3D models (download them yourself: see breakout-board/README.md, 3D models)
breakout-board/kicad/3d/
breakout-board/generator/route_best.kicad_pcb
breakout-board/cht-board/generator/out/
breakout-board/cht-board/generator/route.dsn
breakout-board/cht-board/generator/route.ses
breakout-board/cht-board/kicad/*-backups/
